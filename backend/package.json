{
  "name": "cloudcart-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CloudCart Lambda functions",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "build": "npm run build:products && npm run build:cart && npm run build:orders && npm run build:inventory && npm run build:notifications",
    "build:products": "esbuild functions/products/handler.ts --bundle --minify --platform=node --target=node24 --outfile=dist/products/index.js",
    "build:cart": "esbuild functions/cart/handler.ts --bundle --minify --platform=node --target=node24 --outfile=dist/cart/index.js",
    "build:orders": "esbuild functions/orders/handler.ts --bundle --minify --platform=node --target=node24 --outfile=dist/orders/index.js",
    "build:inventory": "esbuild functions/inventory/handler.ts --bundle --minify --platform=node --target=node24 --outfile=dist/inventory/index.js",
    "build:notifications": "esbuild functions/notifications/handler.ts --bundle --minify --platform=node --target=node24 --outfile=dist/notifications/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-xray-sdk-core": "^3.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "esbuild": "^0.25.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
