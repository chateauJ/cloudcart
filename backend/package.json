{
  "name": "cloudcart-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CloudCart Lambda functions",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:products": "esbuild functions/products/handler.ts --bundle --minify --platform=node --target=node20 --outfile=dist/products/index.js",
    "build:cart": "esbuild functions/cart/handler.ts --bundle --minify --platform=node --target=node20 --outfile=dist/cart/index.js",
    "build:orders": "esbuild functions/orders/handler.ts --bundle --minify --platform=node --target=node20 --outfile=dist/orders/index.js",
    "build:inventory": "esbuild functions/inventory/handler.ts --bundle --minify --platform=node --target=node20 --outfile=dist/inventory/index.js",
    "build:notifications": "esbuild functions/notifications/handler.ts --bundle --minify --platform=node --target=node20 --outfile=dist/notifications/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-xray-sdk-core": "^3.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
