{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "aws-lambda", "jest"]
  },
  "include": ["functions/**/*.ts", "shared/**/*.ts", "test/**/*.ts", "integration/**/*.ts"]
}
